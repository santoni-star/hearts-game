<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5E20"
    android:fitsSystemWindows="true">

    <com.example.heartsgame.ui.TableBackgroundView
        android:id="@+id/table_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2E7D32"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">

                <TextView
                    android:id="@+id/west_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="West"
                    android:textColor="#CCFFCC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/west_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">

                <TextView
                    android:id="@+id/round_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Round 1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pass_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pass 3 cards LEFT"
                    android:textColor="#FFD700"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">

                <TextView
                    android:id="@+id/north_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="North"
                    android:textColor="#CCFFCC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/north_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">

                <TextView
                    android:id="@+id/deck_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deck: 0"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/hearts_broken"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#FF6B6B"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="2dp">

                <TextView
                    android:id="@+id/east_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="East"
                    android:textColor="#CCFFCC"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/east_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/new_game_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="New Game"
                android:textSize="10sp"
                android:paddingHorizontal="12dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/west_hand"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp" />

            <FrameLayout
                android:id="@+id/center_play_area"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.4"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/trick_cards"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/trick_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|top"
                    android:layout_marginTop="16dp"
                    android:text="Your turn - Play a card"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="#80000000"
                    android:padding="8dp 16dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/pass_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#CC000000"
                    android:visibility="gone"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/pass_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pass 3 Cards"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/pass_direction_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pass to LEFT"
                        android:textColor="#FFD700"
                        android:textSize="16sp"
                        android:layout_marginBottom="24dp" />

                    <TextView
                        android:id="@+id/pass_instruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap 3 cards to pass, then press CONFIRM"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"
                        android:layout_marginBottom="24dp"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/pass_confirm_button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="CONFIRM PASS"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="32dp"
                        android:enabled="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pass_reveal_area"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/round_end_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#CC000000"
                    android:visibility="gone"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/round_end_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Round Complete"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:id="@+id/round_scores_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="24dp" />

                    <Button
                        android:id="@+id/next_round_button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="NEXT ROUND"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="32dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/game_over_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#CC000000"
                    android:visibility="gone"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/game_over_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAME OVER"
                        android:textColor="#FFD700"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/game_over_winner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Winner: You!"
                        android:textColor="#4CAF50"
                        android:textSize="20sp"
                        android:layout_marginBottom="24dp" />

                    <LinearLayout
                        android:id="@+id/final_scores_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="24dp" />

                    <Button
                        android:id="@+id/play_again_button"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="PLAY AGAIN"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="32dp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/moon_celebration"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/east_hand"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/south_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You"
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/south_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: 0 | Round: 0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/south_hand_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/south_hand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="4dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/action_buttons"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/play_button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="PLAY"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:enabled="false" />

                <Button
                    android:id="@+id/pass_button"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="PASS"
                    android:textSize="14sp"
                    android:paddingHorizontal="24dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>