<resources>
    <!-- Base application theme -->
    <style name="Theme.HeartsGame" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_700</item>
        <item name="colorPrimaryVariant">@color/green_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/amber_500</item>
        <item name="colorSecondaryVariant">@color/amber_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor">@color/green_900</item>
        <item name="android:navigationBarColor">@color/green_900</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Colors for Hearts game -->
    <color name="green_700">#2E7D32</color>
    <color name="green_800">#1B5E20</color>
    <color name="green_900">#0D4711</color>
    <color name="amber_500">#FFD700</color>
    <color name="amber_700">#F9A825</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="red_hearts">#CC0000</color>
    <color name="black_spades">#000000</color>
    <color name="felt_green">#1B5E20</color>
    <color name="felt_dark">#0D4711</color>
    <color name="felt_light">#2E7D32</color>
    <color name="card_white">#FFFFFF</color>
    <color name="card_shadow">#33000000</color>
    <color name="selection_green">#4CAF50</color>
    <color name="selection_yellow">#FFD700</color>
    <color name="playable_glow">#3300AA00</color>
    <color name="beatable_glow">#4400CC00</color>
</resources>